# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real values.

# Optional standalone WP6 backend settings. The integrated platform uses backend/.env at the repository root.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
JWT_SECRET=replace-with-at-least-32-random-bytes
API_BASE_URL=http://localhost:8006
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
# Profile assistant: Groq free plan (console.groq.com > API Keys). Backend only: never give it a VITE_ prefix.
GROQ_API_KEY=gsk_YOUR_KEY
GROQ_MODEL=openai/gpt-oss-120b

# Frontend (Vite reads this file through envDir: '..'; only VITE_ names reach the browser)
VITE_API_BASE_URL=http://localhost:8006
