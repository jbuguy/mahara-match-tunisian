APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mahara_match
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=30
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAHARA_ENABLE_DEMO_USERS=true
MAHARA_DEMO_PASSWORD=123456789.Demo
MAHARA_LLM_BASE_URL=http://localhost:1234
MAHARA_LLM_MODEL=qwen2.5-7b-instruct-1m
MAHARA_LLM_API_KEY=
MAHARA_EMBEDDING_PROVIDER=openai-compatible
MAHARA_EMBEDDING_BASE_URL=http://localhost:8080
MAHARA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAHARA_EMBEDDING_API_KEY=
MAHARA_EMBEDDING_DIMENSIONS=384
MAHARA_EMBEDDING_TIMEOUT_SECONDS=30
MAHARA_RAG_TOP_K=5
MAHARA_RAG_SIMILARITY_THRESHOLD=0.3
MAHARA_RAG_RETRIEVAL_TIMEOUT_SECONDS=5
MAHARA_RAG_CHUNK_SIZE=350
MAHARA_RAG_CHUNK_OVERLAP=50
MAHARA_RAG_VECTOR_WEIGHT=0.7
MAHARA_WHISPER_BASE_URL=http://localhost:9000
MAHARA_WHISPER_MODEL=whisper-large-v3-turbo
MAHARA_WHISPER_API_KEY=
MAHARA_TTS_BASE_URL=http://localhost:5000
MAHARA_TTS_MODEL=tts-1
MAHARA_TTS_VOICE=alloy
MAHARA_TTS_API_KEY=
