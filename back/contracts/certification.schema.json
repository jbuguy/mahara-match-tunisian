{
  "$defs": {
    "VerificationStatus": {
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 2,
      "title": "Title",
      "type": "string"
    },
    "training_course_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Course Id"
    },
    "provider_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Id"
    },
    "issued_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issued On"
    },
    "expires_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires On"
    },
    "verification_status": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "pending"
    },
    "document_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Id"
    }
  },
  "required": [
    "candidate_id",
    "title"
  ],
  "title": "CertificationRecord",
  "type": "object"
}
