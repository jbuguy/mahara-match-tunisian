# Shared backend settings
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Mahara Match
SMTP_STARTTLS=true
SMTP_USE_SSL=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Mahara Match
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model
LLM_EMBEDDING_MODEL=multilingual-e5-base
LLM_API_KEY=
# Local STT provider: whisper or farukstt
STT_PROVIDER=whisper
WHISPER_MODEL=TheBiggyBang/whisper-small-tunisian-derja
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_LANGUAGE_DETECTION=true
# The published FarukSTT repository is medyas/FarukSTT (not FARUKxAUTO/FarukSTT).
FARUKSTT_MODEL=medyas/FarukSTT
FARUKSTT_DEVICE=auto
FARUKSTT_COMPUTE_TYPE=float32
FARUKSTT_LANGUAGE=auto
STT_MAX_AUDIO_BYTES=26214400
# Ministry market-data worker (python -m app.features.ministry.worker)
# Official JSON feed returning a MarketDatasetSubmission; empty disables POST /admin/market/refresh (503)
MINISTRY_MARKET_FEED_URL=
# Optional bearer token sent to the feed as 'Authorization: Bearer <token>'
MINISTRY_MARKET_FEED_TOKEN=
# Seconds the worker sleeps when no refresh job is queued (must be > 0)
MINISTRY_MARKET_WORKER_POLL_SECONDS=3.0
# HTTP timeout in seconds for one feed request
MINISTRY_MARKET_FEED_TIMEOUT_SECONDS=30.0
