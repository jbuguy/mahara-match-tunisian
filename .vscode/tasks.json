{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Mahara Match API",
			"type": "shell",
			"command": "$env:PYTHONPATH='backend'; & .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Start Mahara Match frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}